# ── Artha AI 2.0 — Production Environment Template (.env.production) ──────────

# System Core Mode
NODE_ENV=production
PORT=4000
DEMO_MODE=false

# Groq AI Engine Key (Required for LLM trade rationale generation)
GROQ_API_KEY=gsk_your_production_groq_api_key_here

# Angel One SmartAPI Production Credentials
SMARTAPI_CLIENT_ID=A1234567
SMARTAPI_PASSWORD=1234
SMARTAPI_API_KEY=your_smartapi_production_api_key
SMARTAPI_TOTP_SECRET=JBSWY3DPEHPK3PXP

# ── Static Outbound IP Proxy (Fixes Railway dynamic IP issue AG8002) ─────────
# When deployed on Railway / Render / cloud with rotating IPs:
# 1. Sign up for Fixie (https://www.usefixie.com) or QuotaGuard Static.
# 2. Get your dedicated static outbound IP (e.g., 54.83.120.55).
# 3. Whitelist that static IP in Angel One SmartAPI Developer portal under "Primary Static IP".
# 4. Set FIXIE_URL and SMARTAPI_STATIC_IP below in your Railway/production environment variables:
FIXIE_URL=http://fixie:your_fixie_token_here@speedy-us-west-1.fixie.io:8080
SMARTAPI_STATIC_IP=54.83.120.55

# Browser Push Notification VAPID Keys (Generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=BDm...your_vapid_public_key...
VAPID_PRIVATE_KEY=your_vapid_private_key

# TimescaleDB Database Password (Optional)
POSTGRES_PASSWORD=artha_prod_secure_password_2026
